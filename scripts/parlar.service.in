# Generated by ParlAR setup.sh. Local edits may be replaced by a later setup run.
[Unit]
Description=ParlAR, daemon de dictado local
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@PARLAR_WORKDIR@
ExecStart=@PARLAR_PYTHON@ -m parlar
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
